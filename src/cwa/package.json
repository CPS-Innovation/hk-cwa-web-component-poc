{
  "name": "cwa",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/cwa/cwa.esm.js",
  "exports": {
    ".": {
      "import": "./dist/cwa/cwa.esm.js",
      "require": "./dist/cwa/cwa.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "date-fns": "^2.30.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0",


"@azure/msal-browser": "^2.38.0",

    "@cypress/instrument-cra": "^1.4.0",
    "@microsoft/applicationinsights-react-js": "^3.4.2",
    "@microsoft/applicationinsights-web": "^2.8.14",
    "@microsoft/microsoft-graph-client": "^3.0.0",

    "@types/faker": "^5.5.9",
    "@types/lodash.debounce": "^4.0.6",
    "@types/qs": "^6.9.7",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.3.2",
    "@types/uuid": "^8.3.4",
    "date-fns-tz": "^2.0.0",
    "del": "^6.0.0",
    "env-cmd": "^10.1.0",
    "faker": "5.5.3",
    "fast-csv": "^4.3.6",
    "fetch-jsonp": "^1.3.0",
    "govuk_frontend_toolkit": "^9.0.1",
    "govuk-frontend": "^4.0.1",
    "govuk-react-jsx": "^7.1.0",
    "istanbul-lib-coverage": "^3.2.0",
    "jest-junit": "^13.1.0",
    "lint-staged": "^13.3.0",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "msw": "^0.35.0",
    "nyc": "^15.1.0",
    "pdfjs-dist": "4.4.168",
    "prettier": "^2.8.8",
    "qs": "^6.10.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.48.2",
    "react-rnd": "^10.3.7",
    "react-router-dom": "^5.3.0",
    "react-scripts": "5.0.1",
    "rimraf": "^3.0.2",
    "sass": "~1.68.0",
    "serve": "^14.2.0",
    "start-server-and-test": "^2.0.3",
    "typescript": "^4.6.3",
    "use-reducer-async": "^2.1.1",
    "uuid": "^9.0.0",
    "web-vitals": "^1.0.1",
    "xunit-viewer": "^10.3.0"

  },
  "license": "MIT",
  "dependencies": {
    "@microsoft/applicationinsights-react-js": "^19.3.7",
    "@microsoft/applicationinsights-web": "^3.3.9",
    "date-fns-tz": "^2.0.1",
    "govuk-react-jsx": "^7.1.0",
    "jest-fetch-mock": "^3.0.3"
  }
}
